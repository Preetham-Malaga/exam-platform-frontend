# Copy to .env.local for development. NEVER commit .env files.
# Everything starting with VITE_ is PUBLIC (shipped to every browser). Only public values belong here.
# Never add the Supabase service role key, database/Redis credentials or JWT secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000
