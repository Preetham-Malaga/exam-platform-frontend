# End-to-end test accounts. Copy to .env.e2e (git-ignored) or create it with `npm run seed:e2e` in the backend.
# See docs/test-accounts.md. Never commit real passwords.
E2E_PASSWORD=
E2E_OWNER_EMAIL=e2e.owner@exam-platform.test
E2E_ADMIN_EMAIL=e2e.admin@exam-platform.test
E2E_TEACHER_EMAIL=e2e.teacher@exam-platform.test
E2E_STUDENT_EMAIL=e2e.student@exam-platform.test
# Optional: test an already running app instead of starting Vite.
# E2E_BASE_URL=http://localhost:5173
# Optional: chromium instead of the installed Google Chrome.
# PW_CHANNEL=chromium
